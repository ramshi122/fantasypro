rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // SECURITY: admin_data — SERVER-ONLY writes
    // ============================================================
    // Client can READ for real-time sync (onSnapshot).
    // Client CANNOT write — all writes go through server API routes
    // using Firebase Admin SDK.
    match /admin_data/{docId} {
      allow read: if true;            // Real-time sync reads
      allow create: if false;         // SERVER-ONLY
      allow update: if false;         // SERVER-ONLY
      allow delete: if false;         // SERVER-ONLY
    }

    // ============================================================
    // SECURITY: license_keys — SERVER-ONLY writes
    // ============================================================
    // Client can READ for verification only.
    // Client CANNOT create/update/delete — prevents key injection.
    match /license_keys/{keyId} {
      allow read: if true;            // Verification reads
      allow create: if false;         // SERVER-ONLY (admin API)
      allow update: if false;         // SERVER-ONLY
      allow delete: if false;         // SERVER-ONLY
    }

    // ============================================================
    // SECURITY: admin_generated_keys — SERVER-ONLY writes
    // ============================================================
    match /admin_generated_keys/{keyId} {
      allow read: if true;            // Cross-device discovery
      allow create: if false;         // SERVER-ONLY
      allow update: if false;         // SERVER-ONLY
      allow delete: if false;         // SERVER-ONLY
    }

    // ============================================================
    // Payment orders — READ-ONLY from client
    // ============================================================
    match /payment_orders/{orderId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // Users collection — READ-ONLY from client
    // ============================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // Referrals collection — READ-ONLY from client
    // ============================================================
    match /referrals/{referralId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // Default — DENY ALL other collections
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
