rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // LICENSE KEYS — SINGLE SOURCE OF TRUTH (one doc per key)
    // ============================================================
    // Collection: license_keys/{keyStr}
    // Each key is its own document (atomic writes, no race conditions).
    //
    // All clients read and write here:
    //   - Admin Web Panel (admin-store.ts → firebase-license.ts)
    //   - Old Admin APK (same code path — loads same Vercel deployment)
    //   - New Admin APK (same code path — loads same Vercel deployment)
    //   - User APK (verifyLicense → fetchKeyFromFirestore)
    //   - API routes (/api/license/verify, api-license-guard.ts)
    //
    // Real-time sync: admin-realtime-sync.ts attaches onSnapshot to the
    // COLLECTION — any key change instantly notifies all admin panels.
    //
    // 1 KEY = 1 DEVICE policy enforced in code (deviceIds[] array).
    match /license_keys/{keyId} {
      allow read: if true;            // Verification reads (user + admin)
      allow create: if true;          // Admin generates keys (client-side)
      allow update: if true;          // Admin updates (suspend, activate, device binding)
      allow delete: if true;          // Admin deletes keys
    }

    // ============================================================
    // Default — DENY ALL other collections
    // ============================================================
    // No admin_data, no arrays, no other collections.
    // Everything lives in license_keys/{keyStr}.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
