rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // LICENSE KEYS — Admin can read + write from client
    // ============================================================
    // User APK reads here on activation.
    // Admin APK writes here on key generation, suspend, activate, delete.
    // 1 KEY = 1 DEVICE policy enforced in code (deviceIds[] array).
    match /license_keys/{keyId} {
      allow read: if true;            // Verification reads (user + admin)
      allow create: if true;          // Admin generates keys (client-side)
      allow update: if true;          // Admin updates (suspend, activate, device binding)
      allow delete: if true;          // Admin deletes keys
    }

    // ============================================================
    // ADMIN GENERATED KEYS — discovery log (cross-device)
    // ============================================================
    // When admin phone A generates a key, it records it here so
    // admin phone B can discover the new key and pull it locally.
    match /admin_generated_keys/{keyId} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // Default — DENY ALL other collections
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
